<?xml version="1.0" encoding="utf-8"?>
<!-- Isi lembar galat: ikon bulat, judul, dan penjelasan. Teksnya diisi dari kode sesuai jenis galat. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:backgroundTint="@color/navy_lembut"
        android:background="@drawable/bg_lingkaran_dasar">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_galat" />
    </FrameLayout>

    <TextView
        android:id="@+id/galat_judul"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:textColor="@color/teks_judul"
        android:textSize="21sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/galat_isi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/teks_redup"
        android:textSize="15sp" />
</LinearLayout>
