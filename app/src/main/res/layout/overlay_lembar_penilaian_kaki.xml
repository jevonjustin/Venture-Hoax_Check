<?xml version="1.0" encoding="utf-8"?>
<!-- Kaki lembar penilaian: Lihat Hasil (nonaktif sampai ada pilihan) dan Lewati -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp">

    <Button
        android:id="@+id/penilaian_lihat_hasil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tombol_utama"
        android:enabled="false"
        android:minHeight="@dimen/lembar_tombol_utama"
        android:stateListAnimator="@null"
        android:text="@string/penilaian_lihat_hasil"
        android:textAllCaps="false"
        android:textColor="@color/tombol_nonaktif_teks"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/penilaian_lewati"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tombol_teks"
        android:minHeight="@dimen/lembar_tombol_sekunder"
        android:stateListAnimator="@null"
        android:text="@string/penilaian_lewati"
        android:textAllCaps="false"
        android:textColor="@color/navy"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
