<?xml version="1.0" encoding="utf-8"?>
<!--
    Isi lembar penilaian awal: label "bagian yang dipilih" dengan pil status analisis di bawahnya (agar label tidak terpotong), thumbnail
    potongan, pertanyaan, dan tiga opsi radio. Tinggi semua teks mengikuti isi (tanpa tinggi tetap).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="4dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.05"
            android:text="@string/penilaian_bagian_dipilih"
            android:textColor="@color/teks_redup"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Pil status; liveRegion membuat pembaca layar mengumumkan perubahan statusnya -->
        <LinearLayout
            android:id="@+id/penilaian_pil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/bg_pil_status"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp">

            <ProgressBar
                android:id="@+id/penilaian_putar"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/navy" />

            <ImageView
                android:id="@+id/penilaian_ikon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <TextView
                android:id="@+id/penilaian_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:textColor="@color/tingkat_tidak_ditemukan_ink"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/penilaian_bingkai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_thumbnail"
        android:padding="10dp">

        <ImageView
            android:id="@+id/penilaian_thumbnail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:contentDescription="@string/penilaian_thumbnail_deskripsi"
            android:maxHeight="@dimen/lembar_thumbnail"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/penilaian_pertanyaan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/penilaian_pertanyaan"
        android:textColor="@color/teks_judul"
        android:textSize="18sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/penilaian_opsi"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/penilaian_opsi_percaya"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_opsi"
            android:button="@null"
            android:drawableStart="@drawable/bg_radio"
            android:drawablePadding="14dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/lembar_opsi_tinggi"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="@string/penilaian_percaya"
            android:textColor="@color/teks_judul"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/penilaian_opsi_ragu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_opsi"
            android:button="@null"
            android:drawableStart="@drawable/bg_radio"
            android:drawablePadding="14dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/lembar_opsi_tinggi"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="@string/penilaian_ragu"
            android:textColor="@color/teks_judul"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioButton
            android:id="@+id/penilaian_opsi_tidak_percaya"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_opsi"
            android:button="@null"
            android:drawableStart="@drawable/bg_radio"
            android:drawablePadding="14dp"
            android:gravity="center_vertical"
            android:minHeight="@dimen/lembar_opsi_tinggi"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:text="@string/penilaian_tidak_percaya"
            android:textColor="@color/teks_judul"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RadioGroup>
</LinearLayout>
