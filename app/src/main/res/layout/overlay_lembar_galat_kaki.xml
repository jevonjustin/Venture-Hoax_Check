<?xml version="1.0" encoding="utf-8"?>
<!-- Kaki lembar galat: tombol utama, tombol kedua "Buka pengaturan" (opsional), dan Tutup -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="16dp">

    <Button
        android:id="@+id/galat_aksi_utama"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tombol_utama"
        android:minHeight="@dimen/lembar_tombol_utama"
        android:stateListAnimator="@null"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/galat_aksi_kedua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_tombol_garis"
        android:minHeight="@dimen/lembar_tombol_utama"
        android:stateListAnimator="@null"
        android:text="@string/galat_aksi_pengaturan"
        android:textAllCaps="false"
        android:textColor="@color/navy"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/galat_tutup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_tombol_teks"
        android:minHeight="@dimen/lembar_tombol_sekunder"
        android:stateListAnimator="@null"
        android:text="@string/galat_aksi_tutup"
        android:textAllCaps="false"
        android:textColor="@color/navy"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
