<?xml version="1.0" encoding="utf-8"?>
<!--
    Isi lembar hasil (rujukan urutan: docs/prototype/prototype.html, bagian kartu hasil). Bagian yang
    bergantung pada data (artikel, ciri, chip) diisi dari kode; bagian yang boleh kosong
    awalnya gone. Semua teks memakai tinggi menyesuaikan isi.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <!-- 1. Banner tingkat; warna latar dan teks diatur dari kode sesuai tingkat -->
    <LinearLayout
        android:id="@+id/hasil_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_banner"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_ikon_lingkaran">

                <ImageView
                    android:id="@+id/hasil_banner_ikon"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/hasil_banner_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="1"
                    android:letterSpacing="0.05"
                    android:text="@string/hasil_banner_label"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hasil_banner_judul"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/banner_ikon_latar"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/hasil_banner_keterangan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.1"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 2. Keterangan pemeriksaan terbatas -->
    <LinearLayout
        android:id="@+id/hasil_terbatas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kartu_putih"
        android:backgroundTint="@color/tingkat_hati_hati_soft"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hasil_terbatas_judul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hasil_terbatas_judul"
            android:textColor="@color/tingkat_hati_hati_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/hasil_terbatas_daftar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/hasil_terbatas_arti"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/teks_judul"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 3. Chip ringkasan -->
    <com.example.cekhoaks.TataLetakAlir
        android:id="@+id/hasil_chip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp" />

    <!-- 4. Inti pesan -->
    <LinearLayout
        android:id="@+id/hasil_inti"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kartu_putih"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hasil_inti_judul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hasil_bagian_inti"
            android:textColor="@color/teks_judul"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hasil_inti_isi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_kotak_kutip"
            android:lineSpacingMultiplier="1.1"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:textColor="@color/teks_judul"
            android:textSize="15sp"
            android:textStyle="italic" />
    </LinearLayout>

    <!-- 5. Artikel cek fakta -->
    <LinearLayout
        android:id="@+id/hasil_artikel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kartu_putih"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hasil_artikel_judul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hasil_bagian_artikel"
            android:textColor="@color/teks_judul"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/hasil_artikel_daftar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- 6. Ciri yang ditemukan -->
    <LinearLayout
        android:id="@+id/hasil_ciri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kartu_putih"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/hasil_ciri_judul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hasil_bagian_ciri"
            android:textColor="@color/teks_judul"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/hasil_ciri_daftar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <!-- 7. Dibanding penilaian awal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kartu_putih"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/hasil_banding_judul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hasil_bagian_perbandingan"
            android:textColor="@color/teks_judul"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_kotak_dasar"
                android:backgroundTint="@color/chip_netral"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/banding_penilaian_awal"
                    android:textColor="@color/teks_redup"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hasil_banding_awal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/navy"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/hasil_banding_kotak_temuan"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_kotak_dasar"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/hasil_banding_label_temuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/banding_temuan_sistem"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hasil_banding_temuan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/hasil_banding_pesan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/teks_judul"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 8. Teks yang terbaca (dapat dilipat, awalnya terlipat) -->
    <LinearLayout
        android:id="@+id/hasil_teks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kartu_putih"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/hasil_teks_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="48dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hasil_teks_judul"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/hasil_bagian_teks"
                android:textColor="@color/teks_judul"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/hasil_teks_panah"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_bawah" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/hasil_teks_isi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/hasil_teks_terbaca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/teks_isi"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/hasil_teks_catatan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/hasil_teks_catatan"
                android:textColor="@color/teks_redup"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 9. Tips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_kartu_putih"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/hasil_tips_judul"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hasil_bagian_tips"
            android:textColor="@color/teks_judul"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/hasil_tips_isi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/teks_isi"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
