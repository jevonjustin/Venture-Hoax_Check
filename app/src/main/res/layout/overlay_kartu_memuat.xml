<?xml version="1.0" encoding="utf-8"?>
<!-- Kartu "sedang dianalisis" di tengah layar: spinner navy, judul, satu kalimat, dan tombol Batal -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_marginStart="32dp"
    android:layout_marginEnd="32dp"
    android:background="@drawable/bg_kartu_memuat"
    android:clickable="true"
    android:focusable="false"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="30dp"
    android:paddingEnd="26dp"
    android:paddingBottom="24dp">

    <ProgressBar
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@string/memuat_deskripsi"
        android:indeterminate="true"
        android:indeterminateTint="@color/navy" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="@string/memuat_judul"
        android:textColor="@color/teks_judul"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/memuat_isi"
        android:textColor="@color/teks_redup"
        android:textSize="15sp" />

    <Button
        android:id="@+id/memuat_batal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_tombol_garis"
        android:contentDescription="@string/memuat_batal_deskripsi"
        android:minWidth="160dp"
        android:minHeight="@dimen/lembar_tombol_sekunder"
        android:stateListAnimator="@null"
        android:text="@string/memuat_batal"
        android:textAllCaps="false"
        android:textColor="@color/navy"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
