<?xml version="1.0" encoding="utf-8"?>
<!-- Satu ciri: lencana, nama, teks keyakinan, chip bukti dalam kutip, dan penjelasan -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/ciri_lencana"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_lingkaran_dasar">

            <ImageView
                android:id="@+id/ciri_lencana_ikon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_seru_kecil" />
        </FrameLayout>

        <TextView
            android:id="@+id/ciri_nama"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:textColor="@color/teks_judul"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/ciri_keyakinan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="2dp"
        android:textColor="@color/teks_redup"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.example.cekhoaks.TataLetakAlir
        android:id="@+id/ciri_bukti"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/ciri_penjelasan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.1"
        android:textColor="@color/teks_redup"
        android:textSize="14sp" />
</LinearLayout>
