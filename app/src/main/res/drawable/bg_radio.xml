<?xml version="1.0" encoding="utf-8"?>
<!-- Titik radio 22dp: terpilih berisi navy dengan cincin putih di dalam -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/navy" />
                    <size
                        android:width="22dp"
                        android:height="22dp" />
                </shape>
            </item>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <solid android:color="@color/white" />
                </shape>
            </item>
            <item
                android:bottom="7dp"
                android:left="7dp"
                android:right="7dp"
                android:top="7dp">
                <shape android:shape="oval">
                    <solid android:color="@color/navy" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/white" />
            <stroke
                android:width="2dp"
                android:color="@color/radio_garis" />
            <size
                android:width="22dp"
                android:height="22dp" />
        </shape>
    </item>
</selector>
